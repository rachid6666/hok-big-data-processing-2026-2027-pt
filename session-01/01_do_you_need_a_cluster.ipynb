    "## 6. Why file formats matter: Parquet vs. CSV\n",
    "Parquet is **columnar**, **compressed** and stores **min/max statistics** per row group.\n",
    "CSV is none of that."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "2a272bb4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Parquet     50 MB\n",
      "CSV        359 MB\n",
      "duckdb on Parquet              0.03 s   Δ RSS       2 MB\n",
      "duckdb on CSV                  0.83 s   Δ RSS       0 MB\n"
     ]
    }
   ],
   "source": [
    "one = FILES[0]\n",
    "pl.read_parquet(one).write_csv(\"../data/one_month.csv\")\n",
    "print(f\"Parquet {os.path.getsize(one)/1e6:6.0f} MB\")\n",
    "print(f\"CSV     {os.path.getsize('../data/one_month.csv')/1e6:6.0f} MB\")\n",
    "\n",
    "q = \"SELECT avg(tip_amount) FROM {src} WHERE payment_type = 1\"\n",
    "timed(\"duckdb on Parquet\", lambda: con.sql(q.format(src=f\"'{one}'\")).fetchall())\n",
    "timed(\"duckdb on CSV\",     lambda: con.sql(q.format(src=\"'../data/one_month.csv'\")).fetchall());"
   ]
