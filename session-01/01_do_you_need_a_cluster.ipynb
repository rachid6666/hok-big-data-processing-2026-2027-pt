   "source": [
    "# A tiny timing helper we reuse everywhere\n",
    "def timed(label, fn):\n",
    "    proc = psutil.Process()\n",
    "    rss0 = proc.memory_info().rss\n",
    "    t0 = time.perf_counter()\n",
    "    result = fn()\n",
    "    dt = time.perf_counter() - t0\n",
    "    drss = (proc.memory_info().rss - rss0) / 1e6\n",
    "    print(f\"{label:<28} {dt:6.2f} s   Δ RSS {drss:7.0f} MB\")\n",
    "    return result, dt"
   ]
  },
